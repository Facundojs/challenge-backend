# Pooled (PgBouncer): usado por la API
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/neondb?sslmode=verify-full
# Directa (sin -pooler): worker (LISTEN/NOTIFY), migraciones y tests
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/neondb?sslmode=verify-full
PORT=3000
